# MySQL connection
DB_URL=jdbc:mysql://localhost:3306/document_storer_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=

# Generate with: openssl rand -base64 32
JWT_SECRET=

# Optional initial administrator; set both before first startup.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=System Administrator

# Exact allowed browser origins (comma-separated)
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081

APP_FILE_UPLOAD_DIR=./uploads

# Optional file encryption: set true and configure a separate key.
APP_ENCRYPTION_ENABLED=false
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
